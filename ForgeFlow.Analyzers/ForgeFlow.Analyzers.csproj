<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Roslyn analyzers must not use implicit usings — generated using files are unavailable in the analyzer host -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!--
      Note: <IsRoslynComponent>true</IsRoslynComponent> is intentionally omitted.
      That property triggers a Visual Studio prompt to install the ".NET Compiler
      Platform SDK" component, which is only required for the VS "Debug as analyzer"
      experience. The analyzer builds and runs fine without it.
    -->
    <!-- Suppress package authoring warnings — this project is consumed directly, not NuGet-packaged -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn API — private assets so it is not transitively referenced by consumers -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all">
      <IncludeAssets>build</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
